# Copy these into Vercel -> Project -> Settings -> Environment Variables.
# Never commit a real .env file.
ANTHROPIC_API_KEY=sk-ant-...
# Who can sign in: a JSON list, one entry per person. Make an entry (and a strong password) with:
#   node scripts/hash-password.mjs <username> "<Full Name>"
# Only password hashes go here, never the passwords themselves.
GULL_USERS=[{"u":"sadeeq","name":"Sadeeq Khan","h":"scrypt$16384$8$1$..."},{"u":"usama","name":"Usama Hussain","h":"scrypt$16384$8$1$..."}]
# Any long random string; it signs the sessions. Changing it signs every device out.
GULL_SESSION_SECRET=
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=the-service_role-key-from-supabase-project-settings
# Older single-user setups can keep these instead of GULL_USERS (they still work as one extra account):
# GULL_USERNAME=
# GULL_PASSWORD=
